{
  "name": "pistenpuls",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"tsx watch --env-file-if-exists=.env server/node.ts\"",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/node.ts",
    "check": "tsc --noEmit",
    "preview:cf": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "area:add": "tsx tools/add-area.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "three": "^0.128.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^10.0.6",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  }
}
