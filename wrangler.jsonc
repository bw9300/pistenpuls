{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pistenpuls",
  "main": "server/cloudflare.ts",
  "compatibility_date": "2026-10-01",
  // the built frontend; requests that match no file go to the worker (/api/*)
  "assets": { "directory": "./dist", "not_found_handling": "none" },
  // live: one Durable Object (with its own SQLite) per trip
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "LiveRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  // accounts: people, trips, who belongs to which trip, sessions
  "d1_databases": [{ "binding": "DB", "database_name": "pistenpuls", "database_id": "4ec3e7df-be54-421a-9ef6-fb8ec389c2ce" }],
  // secrets: npx wrangler secret put WINDY_KEY

  "env": {
    // npm run deploy:preview → a separate worker (pistenpuls-preview) with its own live data and database
    // secrets: npx wrangler secret put WINDY_KEY --env preview
    "preview": {
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "LiveRoom" }] },
      "d1_databases": [{ "binding": "DB", "database_name": "pistenpuls-preview", "database_id": "6c71eb4d-1956-48e1-82ce-0bb661fdf578" }]
    }
  }
}
