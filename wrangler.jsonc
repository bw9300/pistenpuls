{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pistenpuls",
  "main": "server/cloudflare.ts",
  "compatibility_date": "2026-10-01",
  // the built frontend; requests that match no file go to the worker (/api/*)
  "assets": { "directory": "./dist", "not_found_handling": "none" },
  // live: one Durable Object (with its own SQLite) per group
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "LiveRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  // secrets: npx wrangler secret put WINDY_KEY

  "env": {
    // npm run deploy:preview → a separate worker (pistenpuls-preview) with its own live data
    // secrets: npx wrangler secret put WINDY_KEY --env preview
    "preview": {
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "LiveRoom" }] }
    }
  }
}
